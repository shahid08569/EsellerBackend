{
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_PRODUCTION_SQL_CONNECTION"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS",
    "Issuer": "EsellerAPI",
    "Audience": "EsellerClients",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "https://esellerglobal.com",
      "https://www.esellerglobal.com",
      "https://seller.esellerglobal.com",
      "https://admin.esellerglobal.com",
      "https://affiliate.esellerglobal.com",
      "https://eseller-customer.pages.dev",
      "https://eseller-admin.pages.dev",
      "https://eseller-seller.pages.dev",
      "https://eseller-affiliate.pages.dev",
      "https://eseller.com",
      "https://www.eseller.com",
      "https://seller.eseller.com",
      "https://admin.eseller.com",
      "https://affiliate.eseller.com",
      "http://localhost:4200",
      "http://localhost:4201",
      "http://localhost:4203",
      "http://localhost:54007"
    ]
  },
  "SeedSettings": {
    "AutoMigrate": false,
    "SeedOnStartup": true,
    "SuperAdminEmail": "superadmin@eseller.com",
    "SuperAdminUsername": "superadmin",
    "SuperAdminPassword": ""
  },
  "EmailSettings": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromEmail": "",
    "FromName": "Eseller Marketplace",
    "UseSsl": true,
    "ResendApiKey": ""
  },
  "FileStorageSettings": {
    "BasePath": "wwwroot/uploads",
    "BaseUrl": "https://api.esellerglobal.com"
  },
  "SmsSettings": {
    "UseMock": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/eseller-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "esellerglobal.com;*.esellerglobal.com;api.esellerglobal.com;eseller.com;*.eseller.com;api.eseller.com"
}
